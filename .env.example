# ---------------------------------------------------------------------------
# balladharma — environment variables (example)
# Copy to .env.local and fill in. .env.local is git-ignored.
# ---------------------------------------------------------------------------

# Public site URL — the canonical origin the app is served from.
# Vercel/prod today: https://buddha-balla.com
# On the Mac mini this becomes the Cloudflare hostname (e.g. https://dharma.balla-bot.uk).
NEXT_PUBLIC_SITE_URL=https://buddha-balla.com

# --- AI: meditation teacher chat -------------------------------------------
# Which backend answers the teacher chat.
#   anthropic = direct Anthropic API (current / default)
#   ballabot  = the mini's dharma-llm service (set after Mini move 13)
LLM_PROVIDER=anthropic

# Direct Anthropic API (used while LLM_PROVIDER=anthropic). Removed from the
# mini after cutover to Balla Bot (Checkpoint 3).
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-sonnet-4-6            # optional; defaults in code

# Balla Bot dharma-llm service (used when LLM_PROVIDER=ballabot). Loopback on the mini.
DHARMA_LLM_URL=http://127.0.0.1:8096
DHARMA_LLM_TOKEN=your_dharma_llm_token

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=your_resend_api_key
FEEDBACK_EMAIL=owner@example.com

# ===========================================================================
# CLOUD (Supabase) — used TODAY on Vercel. Removed once the mini migration is
# complete (Mini move 11 decommission). Kept here until then.
# ===========================================================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ===========================================================================
# MAC MINI (self-hosted) — used AFTER the migration. Not needed on Vercel yet.
# ===========================================================================

# Local Postgres on the mini. Read directly (not through PostgREST) so the
# app can map a signed-in Google email to the matching auth.users row —
# that table isn't exposed through PostgREST. Needs `GRANT USAGE ON SCHEMA
# auth, SELECT ON auth.users TO <this role>;` on the mini.
DATABASE_URL=postgres://dharma_owner:PASSWORD@127.0.0.1:5432/dharma

# PostgREST endpoint the app calls for everyone else's data (Mini move 5).
POSTGREST_URL=http://127.0.0.1:8097

# Signs the short-lived token the app mints for PostgREST after sign-in
# (HS256, carries the mapped user's UUID as `sub`). Must match the secret
# already configured on the mini's PostgREST instance.
POSTGREST_JWT_SECRET=your_postgrest_jwt_secret

# Google sign-in via Auth.js (replaces Supabase Auth — Mini move 4).
AUTH_SECRET=your_auth_secret               # `openssl rand -base64 32`
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret
AUTH_ALLOWED_EMAILS=you@example.com        # comma-separated allowlist
